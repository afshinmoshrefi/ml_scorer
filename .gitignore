# Python
__pycache__/
*.pyc

# Training data (too large for git)
features/

# Model files (binary, regenerated by training)
models/

# CatBoost internal
catboost_info/

# Training logs
*.txt

# Walk-forward prediction parquets (large, regenerated by --save-predictions)
results/wf_predictions_*.parquet
results/backtester_input_*.parquet

# Zip archives and production snapshots
*.zip
*in production*/

# Claude Code internal
.claude/

# Temporary doc extraction
docs/_tw_docx_extract/

# Large regenerable prediction/experiment parquets.
# The rule above only matches results/ root; these subdirs hold the same
# kind of artifact (hundreds of MB, regenerated by --save-predictions and
# by the experiment harness) and exceed GitHub's 100MB per-file limit.
results/baseline_snapshot/*.parquet
results/experiments/*.parquet
